# Copy to deploy/backup.env (not committed) and fill in.
BACKUP_DIR=/var/backups/coffeepos
BACKUP_KEEP_DAYS=14
# Public GPG key of the owner (import it first: gpg --import owner.pub). Private key stays OFF the server.
BACKUP_GPG_RECIPIENT=
# Offsite copy via rclone (configure with: rclone config). Example: b2:coffeepos-backups
BACKUP_RCLONE_REMOTE=
# Optional dead-man switch, e.g. https://hc-ping.com/<uuid>
BACKUP_HEALTHCHECK_URL=
